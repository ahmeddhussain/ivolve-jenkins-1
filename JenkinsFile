@Library('jenkins-shared-lib') _

pipeline {
    agent { label 'agent-1' }

    environment {
        IMAGE_NAME = "ahmedkhater2611/jenkins-app"
        IMAGE_TAG  = "${BUILD_NUMBER}"
        NAMESPACE  = "ivolve"
        API_SERVER = "https://192.168.49.2:8443"
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/ahmeddhussain/ivolve-jenkins-1.git'
            }
        }

        stage('Build App') {
            steps {
                buildApp()
            }
        }

        stage('Build & Push Image') {
            steps {
                buildImage("${IMAGE_NAME}", "${IMAGE_TAG}")
            }
        }

        stage('Deploy') {
            steps {
                deployOnK8s("${IMAGE_NAME}", "${IMAGE_TAG}", "${NAMESPACE}", "${API_SERVER}")
            }
        }
    }

    post {
        always {
            echo 'Pipeline finished.'
        }
        success {
            echo 'Deployment completed successfully.'
        }
        failure {
            echo 'Pipeline failed — check logs above.'
        }
    }
}
